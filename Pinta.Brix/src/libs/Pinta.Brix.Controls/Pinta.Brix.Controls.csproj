<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android36.1</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- Library referencing CodeBrix.Platform keeps its OWN RootNamespace
         (heads fail CS0433 on GlobalStaticResources otherwise) -->
    <RootNamespace>Pinta.Brix.Controls</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pinta.Brix.Engine\Pinta.Brix.Engine.csproj" />
    <ProjectReference Include="..\Pinta.Brix.Tools\Pinta.Brix.Tools.csproj" />
    <PackageReference Include="CodeBrix.SkiaSvg.MitLicenseForever" Version="1.0.284.1048" />
  </ItemGroup>

  <!-- The desktop heads: CodeBrix.Platform and its SkiaSharp.Views add-in -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.291.1177" />
    <PackageReference Include="CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever" Version="4.153.1" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twins of the same packages -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <PackageReference Include="CodeBrix.Android.ApacheLicenseForever" Version="1.0.281.1188" />
    <PackageReference Include="CodeBrix.Android.SkiaSharp.Views.ApacheLicenseForever" Version="1.0.281.1188" />
  </ItemGroup>

  <!-- The application icon set carried over from upstream (see
       THIRD-PARTY-NOTICES.txt at the repo root for attribution) -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\icons\**\*.png" />
    <EmbeddedResource Include="Assets\icons\**\*.svg" />
  </ItemGroup>
</Project>
