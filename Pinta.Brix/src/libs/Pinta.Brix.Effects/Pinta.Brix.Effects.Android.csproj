<Project>
  <!-- Its own obj/bin folders: this project sits beside Pinta.Brix.Effects.csproj, which builds the same sources -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj.android\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin.android\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <AssemblyName>Pinta.Brix.Effects</AssemblyName>
    <RootNamespace>Pinta.Brix.Effects</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Builds for Android too because it references Pinta.Brix.Engine, which does -->
  <PropertyGroup>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pinta.Brix.Engine\Pinta.Brix.Engine.Android.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
