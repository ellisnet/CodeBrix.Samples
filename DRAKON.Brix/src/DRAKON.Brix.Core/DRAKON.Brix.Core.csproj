<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>DRAKON.Brix</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.254.167" />
    <PackageReference Include="CodeBrix.Platform.Fonts.OpenSans.ApacheLicenseForever" Version="1.0.248.1181" />
    <!-- The Tk toolkit and its TkHostView XAML element, which the page hosts the
         whole DRAKON Editor UI inside -->
    <PackageReference Include="CodeBrix.Platform.TkCanvas.BsdLicenseForever" Version="1.0.255.1024" />
    <!-- The sqlite3 and pdf4tcl Tcl command shims DRAKON needs to read .drn
         files and export PDFs -->
    <PackageReference Include="CodeBrix.Platform.TclTk.Extras.BsdLicenseForever" Version="1.0.255.1024" />
  </ItemGroup>

  <ItemGroup>
    <!-- The "talk to Tcl" layer (DrakonRuntime + Tcl command shims). Referenced
         here so the platform heads pick it up transitively. -->
    <ProjectReference Include="..\libs\DRAKON.Brix.TclBridge\DRAKON.Brix.TclBridge.csproj" />
  </ItemGroup>

  <!-- The vendored DRAKON Editor Tcl tree + the bootstrap glue script,
       copied beside the binaries so the runtime can source them. -->
  <ItemGroup>
    <None Include="Assets\bootstrap.tcl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\drakon\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
