<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The WPF-hosted head must target net10.0-windows (the runtime package flows a
      Microsoft.WindowsDesktop.App.WPF FrameworkReference). Do NOT set <UseWPF> here -
      that would make the WPF build targets grab the CodeBrix.Platform XAML
      Page items. EnableWindowsTargeting lets this head compile inside the cross-platform
      solution on Linux and macOS build hosts.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Tell MSBuild to treat .xaml files as CodeBrix.Platform XAML pages -->
  <ItemGroup>
    <Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <!-- Shared UI files (App.xaml + Views) -->
  <Import Project="..\PicoScope.Brix.UI\PicoScope.Brix.UI.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\PicoScope.Brix.Core\PicoScope.Brix.Core.csproj" />
    <!-- The real device, registered in Program.cs; PicoScope.Brix.Core only knows the contract -->
    <ProjectReference Include="..\libs\PicoScope.Brix.ScopeData.Ps2000\PicoScope.Brix.ScopeData.Ps2000.csproj" />
  </ItemGroup>

  <!-- EXACTLY ONE platform head package; all other packages come from PicoScope.Brix.Core -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.Runtime.Skia.Wpf.ApacheLicenseForever" Version="1.0.291.1177" />
  </ItemGroup>
</Project>
