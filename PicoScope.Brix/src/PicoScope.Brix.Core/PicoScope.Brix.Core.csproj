<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj.android/**;bin.android/**</DefaultItemExcludes>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>PicoScope.Brix</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="CodeBrix.Platform.Fonts.Roboto.OflLicenseForever" Version="1.0.248.1219" />
  </ItemGroup>

  <!-- The desktop heads: CodeBrix.Platform and its add-ins. The chart control
       brings the CodeBrix.Plotter engine in with it, so nothing in this sample
       references the Plotter package directly. -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.291.1177" />
    <PackageReference Include="CodeBrix.Platform.PlotterView.ApacheLicenseForever" Version="1.0.291.1177" />
  </ItemGroup>

  <!-- The device-agnostic scope contract. The real device (PicoScope.Brix.ScopeData.Ps2000)
       is referenced by the desktop heads, which register it; this project never sees it. -->
  <ItemGroup>
    <ProjectReference Include="..\libs\PicoScope.Brix.ScopeData\PicoScope.Brix.ScopeData.csproj" />
  </ItemGroup>
</Project>
