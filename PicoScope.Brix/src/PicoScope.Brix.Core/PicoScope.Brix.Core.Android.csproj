<Project>
  <!-- Its own obj/bin folders: this project sits beside PicoScope.Brix.Core.csproj, which builds the same sources -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj.android\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin.android\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <AssemblyName>PicoScope.Brix.Core</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>PicoScope.Brix</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="CodeBrix.Platform.Fonts.Roboto.OflLicenseForever" Version="1.0.248.1219" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twins of the same packages. The
       chart control's twin brings the same Plotter engine. -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Android.ApacheLicenseForever" Version="1.0.292.307" />
    <PackageReference Include="CodeBrix.Android.PlotterView.ApacheLicenseForever" Version="1.0.292.307" />
  </ItemGroup>

  <!-- The device-agnostic scope contract. The real device (PicoScope.Brix.ScopeData.Ps2000)
       is referenced by the desktop heads, which register it; this project never sees it. -->
  <ItemGroup>
    <ProjectReference Include="..\libs\PicoScope.Brix.ScopeData\PicoScope.Brix.ScopeData.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
