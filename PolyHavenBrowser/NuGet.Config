<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Chains with the machine/user NuGet.Config (nuget.org); this only ADDS the
       CodeBrix.Platform working-tree local feed the sample's TEMPORARILY-pinned
       1.0.205.9999 packages come from, needed to test not-yet-published
       FrameBuffer/FrameBuffer.Emulated work. Remove this file, and repoint the
       family PackageReferences back to their nuget.org version, after the next
       real CodeBrix.Platform family publish.
       (Re)create the feed from ~/GitHome/CodeBrix.Platform/samples/CodeBrixPlatform/EmulateFrameBufferDemo/pack-local-feed.sh
       NOTE: that script does NOT pack the FlexPanel add-in this sample also pins at
       1.0.205.9999 - pack it separately with the script's csproj-pack command shape,
       run against src/AddIns/Platform.UI.FlexPanel/Platform.UI.FlexPanel.Skia.csproj -->
  <packageSources>
    <add key="CodeBrixPlatformLocalPack" value="../../CodeBrix.Platform/nugets/Release/1.0.205.9999" />
  </packageSources>
</configuration>
