<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj.android/**;bin.android/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.VideoPlayback.MitLicenseForever" Version="1.0.285.833" />
    <PackageReference Include="CodeBrix.VideoPlayback.Skia.MitLicenseForever" Version="1.0.285.833" />
  </ItemGroup>

  <!--
    The AV1 decoder and the Opus audio decoder, both registered once in SkiaVideoRuntime.Initialize().
    Without the first, "av01" has no decoder and nothing plays; without the second, the Opus soundtrack
    every Matroska and WebM file in the corpus carries has none either.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.VideoPlayback.Dav1d.BsdLicenseForever" Version="1.0.271.1206" />
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="1.0.284.1151" />
  </ItemGroup>

  <!--
    The sound device. The playback packages use the device-neutral audio core and leave the output backend
    to the application: the desktop heads get CodeBrix.Audio's native backends (Linux, macOS, Windows);
    the Android head gets CodeBrix.Audio's Android backend from SimpleCbxVideoPlayer.SkiaVideo.Android.csproj.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Audio.MitLicenseForever" Version="1.0.283.1382" />
  </ItemGroup>

</Project>
