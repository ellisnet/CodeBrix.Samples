<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>

    <!-- The Android package name and the name under the launcher icon -->
    <ApplicationId>com.codebrix.samples.inannaoctaquetra</ApplicationId>
    <ApplicationTitle>InannaOctaquetra</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- The shared UI code is written without nullable annotations or implicit usings, so
         every project that compiles it in (each head and the PlayTests project) builds it
         with the same language settings. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Release builds are trimmed; an .apk can be installed directly (the default, .aab, is for app stores) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <!-- Tell MSBuild to treat .xaml files as CodeBrix.Platform XAML pages -->
  <ItemGroup>
    <Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <!-- Shared UI files (App.xaml + Views + Controls) -->
  <Import Project="..\InannaOctaquetra.UI\InannaOctaquetra.UI.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\InannaOctaquetra.Core\InannaOctaquetra.Core.csproj" />
  </ItemGroup>

  <!-- EXACTLY ONE platform head package; all other packages come from InannaOctaquetra.Core -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Android.ApacheLicenseForever" Version="1.0.281.1188" />
  </ItemGroup>
</Project>
