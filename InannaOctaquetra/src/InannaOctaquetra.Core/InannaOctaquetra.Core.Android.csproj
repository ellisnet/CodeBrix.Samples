<Project>
  <!-- Its own obj/bin folders: this project sits beside InannaOctaquetra.Core.csproj, which builds the same sources -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj.android\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin.android\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <AssemblyName>InannaOctaquetra.Core</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>

    <!-- The view models and services are written with nullable annotations, so this project enables them -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>InannaOctaquetra</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageReference Include="CodeBrix.Platform.Fonts.Merriweather.OflLicenseForever" Version="1.0.248.1209" />
    <!-- Writes the INANNA_SNAP snapshot hook's PNG files on every head, Android included -->
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" Version="1.0.285.619" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twin of the same package -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Android.ApacheLicenseForever" Version="1.0.292.307" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\InannaOctaquetra.Reading\InannaOctaquetra.Reading.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
