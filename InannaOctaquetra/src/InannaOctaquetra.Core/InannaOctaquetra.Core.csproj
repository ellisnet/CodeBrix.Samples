<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android36.1</TargetFrameworks>

    <!-- The view models and services are written with nullable annotations, so this project enables them -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>InannaOctaquetra</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="CodeBrix.Platform.Fonts.Merriweather.OflLicenseForever" Version="1.0.248.1209" />
    <!-- Writes the INANNA_SNAP snapshot hook's PNG files on every head, Android included -->
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" Version="1.0.285.619" />
  </ItemGroup>

  <!-- The desktop heads: CodeBrix.Platform -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.291.1177" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twin of the same package -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <PackageReference Include="CodeBrix.Android.ApacheLicenseForever" Version="1.0.281.1188" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\InannaOctaquetra.Reading\InannaOctaquetra.Reading.csproj" />
  </ItemGroup>
</Project>
