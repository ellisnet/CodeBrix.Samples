<Solution>
  <!-- NotionDocumentCreator.WithAndroid.slnx
       The Android solution: everything in NotionDocumentCreator.slnx PLUS the Android head and the
       .Android twins of its library projects, which need the .NET Android workload.
       Open NotionDocumentCreator.slnx instead if you only have the plain .NET SDK. -->
  <Project Path="src/NotionDocumentCreator.UI/NotionDocumentCreator.UI.shproj" />
  <Project Path="src/NotionDocumentCreator.Core/NotionDocumentCreator.Core.csproj" />
  <Project Path="src/NotionDocumentCreator.Core/NotionDocumentCreator.Core.Android.csproj" />
  <Project Path="src/NotionDocumentCreator.LinuxX11/NotionDocumentCreator.LinuxX11.csproj" />
  <Project Path="src/NotionDocumentCreator.LinuxWayland/NotionDocumentCreator.LinuxWayland.csproj" />
  <Project Path="src/NotionDocumentCreator.LinuxFrameBuffer/NotionDocumentCreator.LinuxFrameBuffer.csproj" />
  <Project Path="src/NotionDocumentCreator.MacOS/NotionDocumentCreator.MacOS.csproj" />
  <Project Path="src/NotionDocumentCreator.Win32Skia/NotionDocumentCreator.Win32Skia.csproj" />
  <Project Path="src/NotionDocumentCreator.WinWpfSkia/NotionDocumentCreator.WinWpfSkia.csproj" />
  <Project Path="src/NotionDocumentCreator.Android/NotionDocumentCreator.Android.csproj" />
  <Folder Name="/Libraries/">
    <Project Path="src/libs/NotionDocumentCreator.CreateDocument/NotionDocumentCreator.CreateDocument.csproj" />
  </Folder>
  <Folder Name="/Tests/">
    <Project Path="tests/NotionDocumentCreator.PlayTests/NotionDocumentCreator.PlayTests.csproj" />
    <Project Path="tests/libs/NotionDocumentCreator.CreateDocument.Tests/NotionDocumentCreator.CreateDocument.Tests.csproj" />
  </Folder>
</Solution>
