<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Every picture and font the game shows travels inside this assembly as an embedded resource. -->
  <ItemGroup>
    <None Remove="Art\**\*.svg" />
    <None Remove="Fonts\*.ttf" />
    <None Remove="Fonts\*.txt" />
    <EmbeddedResource Include="Art\**\*.svg" />
    <EmbeddedResource Include="Fonts\*.ttf" />
    <EmbeddedResource Include="Fonts\*.txt" />
  </ItemGroup>
</Project>
