<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj.android/**;bin.android/**</DefaultItemExcludes>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>JustBetweenUs</RootNamespace>
  </PropertyGroup>

  <!-- CodeBrix.Platform needs this define for its internal conditional compilation
       (the CodeBrix.Android package defines both symbols itself for the Android build) -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);HAS_CODEBRIX;HAS_CODEBRIX_WINUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Shared\Helpers\HostHelper.cs" Link="Helpers\HostHelper.cs" />
    <Compile Include="..\..\Shared\ViewModels\EncryptionMode.cs" Link="ViewModels\EncryptionMode.cs" />
    <Compile Include="..\..\Shared\ViewModels\MainViewModel.cs" Link="ViewModels\MainViewModel.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\Shared\Assets\star_icon.json" Link="Assets\star_icon.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />

    <!-- Lottie/Skottie animation support -->
    <PackageReference Include="SkiaSharp.Skottie" Version="4.153.1" />

    <!-- Bundled Open Sans font -->
    <PackageReference Include="CodeBrix.Platform.Fonts.OpenSans.ApacheLicenseForever" Version="1.0.248.1181" />

    <!-- SVG rendering support for SvgImageSource on Skia targets -->
    <PackageReference Include="CodeBrix.SkiaSvg.MitLicenseForever" Version="1.0.291.924" />
  </ItemGroup>

  <!-- The desktop heads: CodeBrix.Platform and its add-ins -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.291.1177" />
    <PackageReference Include="CodeBrix.Platform.Graphics2DSK.ApacheLicenseForever" Version="1.0.291.1177" />
    <PackageReference Include="CodeBrix.Platform.Lottie.ApacheLicenseForever" Version="1.0.291.1177" />
    <PackageReference Include="CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever" Version="4.153.1" />
    <PackageReference Include="CodeBrix.Platform.Svg.ApacheLicenseForever" Version="1.0.291.1177" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
    <Folder Include="ViewModels\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Shared\Assets\clipboard.svg" Link="Assets\clipboard.svg" />
    <EmbeddedResource Include="..\..\Shared\Assets\padlock-icon.svg" Link="Assets\padlock-icon.svg" />
    <EmbeddedResource Include="..\..\Shared\Assets\unlocked-icon.svg" Link="Assets\unlocked-icon.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\JustBetweenUs.Encryption\JustBetweenUs.Encryption.csproj" />
  </ItemGroup>
</Project>
