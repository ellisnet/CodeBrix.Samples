<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      The WPF-hosted head must target net10.0-windows (the runtime package flows a
      Microsoft.WindowsDesktop.App.WPF FrameworkReference). Do NOT set <UseWPF> here -
      that would make the WPF build targets grab the CodeBrix.Platform XAML
      Page items. EnableWindowsTargeting lets this head compile inside the cross-platform
      solution on Linux and macOS build hosts.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- CodeBrix.Platform needs this define for its internal conditional compilation -->
    <DefineConstants>$(DefineConstants);HAS_CODEBRIX;HAS_CODEBRIX_WINUI</DefineConstants>
  </PropertyGroup>

  <!-- Tell MSBuild to treat .xaml files as CodeBrix.Platform XAML pages -->
  <ItemGroup>
    <Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <!-- Shared UI files (linked from JustBetweenUs.UI) -->
  <Import Project="..\JustBetweenUs.UI\JustBetweenUs.UI.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\JustBetweenUs.Core\JustBetweenUs.Core.csproj" />
  </ItemGroup>

  <!--
    Platform-specific package: Skia-on-WPF backend for Windows desktops.
    All other packages come from JustBetweenUs.Core.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.Runtime.Skia.Wpf.ApacheLicenseForever" Version="1.0.291.1177" />
  </ItemGroup>

</Project>
