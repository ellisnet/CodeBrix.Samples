<Project>
  <!-- Its own obj/bin folders: this project sits beside PolyHavenBrowser.Rendering.csproj, which builds the same sources -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj.android\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin.android\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <AssemblyName>PolyHavenBrowser.Rendering</AssemblyName>
    <RootNamespace>PolyHavenBrowser.Rendering</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" Version="1.0.285.619" />
    <PackageReference Include="CodeBrix.Graphics3D.Gltf2.MitLicenseForever" Version="1.0.261.293" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twin of Graphics3DGL (the same GL type, on OpenGL ES).
       The Vulkan renderer (Silk.NET.Vulkan) and the OpenEXR decoder (TinyEXR.NET) are not built
       for Android; the head allow-list in VulkanPlatformSupport.cs stays, so the app reports
       Vulkan as not available there. -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Android.Graphics3DGL.ApacheLicenseForever" Version="1.0.292.307" />
    <Compile Remove="Vulkan\VulkanSceneRenderer.cs;Vulkan\VulkanShaders.cs;Images\ExrDecoder.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
