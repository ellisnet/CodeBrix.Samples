<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" Version="1.0.213.41" />

    <!-- Graphics3DGL supplies, transitively, the CodeBrix.Platform.OpenGL `GL` type the shader
         renderer (GlModelSceneRenderer) draws with. The app codes to Graphics3DGL and never
         references CodeBrix.Platform.OpenGL directly (hard rule). This library hosts no XAML
         control, so it keeps its own default RootNamespace (PolyHavenBrowser.Rendering)-->
    <PackageReference Include="CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever" Version="1.0.214.1259" />

    <PackageReference Include="SharpGLTF.Runtime" Version="1.0.6" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
    <PackageReference Include="TinyEXR.NET" Version="1.1.0" />
  </ItemGroup>
</Project>
