<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj.android/**;bin.android/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" Version="1.0.290.858" />
    <PackageReference Include="CodeBrix.Graphics3D.Gltf2.MitLicenseForever" Version="1.0.290.996" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />

    <!-- The WebGPU backend (WebGpu/): CodeBrix.WebGpu.Skia owns the WebGPU device and the headless
         render target the frames are read back from; it brings CodeBrix.WebGpu.Native (the raw
         WebGPU binding, with the native wgpu library for every desktop platform and Android). -->
    <PackageReference Include="CodeBrix.WebGpu.Skia.MitLicenseForever" Version="1.0.291.34" />
  </ItemGroup>

  <!-- The desktop heads -->
  <ItemGroup>
    <!-- Graphics3DGL supplies, transitively, the CodeBrix.Platform.OpenGL `GL` type the shader
         renderer (GlModelSceneRenderer) draws with. The app codes to Graphics3DGL and never
         references CodeBrix.Platform.OpenGL directly (hard rule). This library hosts no XAML
         control, so it keeps its own default RootNamespace (PolyHavenBrowser.Rendering)-->
    <PackageReference Include="CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever" Version="1.0.291.1177" />

    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="TinyEXR.NET" Version="1.2.0" />
  </ItemGroup>

</Project>
