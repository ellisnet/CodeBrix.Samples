<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android36.1</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" Version="1.0.285.619" />
    <PackageReference Include="CodeBrix.Graphics3D.Gltf2.MitLicenseForever" Version="1.0.261.293" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <!-- The desktop heads -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- Graphics3DGL supplies, transitively, the CodeBrix.Platform.OpenGL `GL` type the shader
         renderer (GlModelSceneRenderer) draws with. The app codes to Graphics3DGL and never
         references CodeBrix.Platform.OpenGL directly (hard rule). This library hosts no XAML
         control, so it keeps its own default RootNamespace (PolyHavenBrowser.Rendering)-->
    <PackageReference Include="CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever" Version="1.0.281.314" />

    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="TinyEXR.NET" Version="1.2.0" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twin of Graphics3DGL (the same GL type, on OpenGL ES).
       The Vulkan renderer (Silk.NET.Vulkan) and the OpenEXR decoder (TinyEXR.NET) are not built
       for Android; the head allow-list in VulkanPlatformSupport.cs stays, so the app reports
       Vulkan as not available there. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <PackageReference Include="CodeBrix.Android.Graphics3DGL.ApacheLicenseForever" Version="1.0.281.1188" />
    <Compile Remove="Vulkan\VulkanSceneRenderer.cs;Vulkan\VulkanShaders.cs;Images\ExrDecoder.cs" />
  </ItemGroup>
</Project>
