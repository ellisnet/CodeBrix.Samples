<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android36.1</TargetFrameworks>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>PolyHavenBrowser</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="CodeBrix.Platform.Fonts.Roboto.OflLicenseForever" Version="1.0.248.1219" />
  </ItemGroup>

  <!-- The desktop heads: CodeBrix.Platform and its add-ins -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.281.314" />

    <!-- SKXamlCanvas - the SkiaSharp drawing surface hosted in CodeBrix.Platform XAML -->
    <PackageReference Include="CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever" Version="4.153.1" />

    <!-- The offscreen model/texture renderer in Display/ builds on Graphics3DGL's
         OffscreenGLContext, which hands back a cross-platform native GL context (WGL on the
         Windows heads, GLX on X11, EGL on Wayland/FrameBuffer, CGL on macOS). The app codes to
         Graphics3DGL — never to CodeBrix.Platform.OpenGL directly — so the OpenGL binding is
         only ever a transitive dependency (Graphics3DGL -> CodeBrix.Platform.OpenGL). -->
    <PackageReference Include="CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever" Version="1.0.281.314" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twins of the same packages. The Vulkan engine is not
       built for Android (its renderer is desktop only); the engine dropdown reports it as not
       available there, as it does on the heads outside the Vulkan allow-list. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <PackageReference Include="CodeBrix.Android.ApacheLicenseForever" Version="1.0.281.1188" />
    <PackageReference Include="CodeBrix.Android.SkiaSharp.Views.ApacheLicenseForever" Version="1.0.281.1188" />
    <PackageReference Include="CodeBrix.Android.Graphics3DGL.ApacheLicenseForever" Version="1.0.281.1188" />
    <Compile Remove="Display\VulkanModelRenderEngine.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\PolyHavenBrowser.PolyHavenApiClient\PolyHavenBrowser.PolyHavenApiClient.csproj" />
    <ProjectReference Include="..\libs\PolyHavenBrowser.Rendering\PolyHavenBrowser.Rendering.csproj" />
  </ItemGroup>
</Project>
