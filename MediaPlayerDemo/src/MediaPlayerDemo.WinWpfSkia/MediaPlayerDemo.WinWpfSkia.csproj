<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Tell MSBuild to treat .xaml files as CodeBrix.Platform XAML pages -->
  <ItemGroup>
    <Page Include="**\*.xaml" Exclude="bin\**\*.xaml;obj\**\*.xaml" />
    <None Remove="**\*.xaml" />
  </ItemGroup>

  <!-- Shared UI files (App.xaml + Views) -->
  <Import Project="..\MediaPlayerDemo.UI\MediaPlayerDemo.UI.projitems" Label="Shared" />
  <ItemGroup>
    <ProjectReference Include="..\MediaPlayerDemo.Core\MediaPlayerDemo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EXACTLY ONE platform head package; all other packages come from MediaPlayerDemo.Core -->
    <PackageReference Include="CodeBrix.Platform.Runtime.Skia.Wpf.ApacheLicenseForever" Version="1.0.210.770" />
    <!--The following package is required on Window heads for the CodeBrix.Platform.MediaPlayer add-in-->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>
</Project>
