<Page
    x:Class="MediaPlayerDemo.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MediaPlayerDemo.ViewModels"
    FontFamily="{StaticResource OpenSansFont}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Height="40"
                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Text="{Binding MediaAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Height="40"
                    VerticalAlignment="Center" Content="Load"
                    Command="{Binding LoadCommand}" />
            <ComboBox Grid.Column="2" Margin="8,0,0,0" Height="40"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding StretchOptions}"
                      SelectedItem="{Binding SelectedStretch, Mode=TwoWay}" />
        </Grid>

        <MediaPlayerElement Grid.Row="1" Margin="0,10,0,10"
                            AutoPlay="True"
                            AreTransportControlsEnabled="True"
                            Source="{Binding PlayerSource, Mode=OneWay}"
                            Stretch="{Binding SelectedStretch, Mode=OneWay}" />

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" />

    </Grid>
</Page>
