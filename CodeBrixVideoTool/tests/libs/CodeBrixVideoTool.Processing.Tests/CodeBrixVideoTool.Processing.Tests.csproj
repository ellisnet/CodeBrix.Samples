<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit.net v3 test projects are self-executing binaries and
         must build as Exe; run via Microsoft.Testing.Platform,
         matching the CodeBrix family test convention. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- The published CodeBrix.Platform package ships REFERENCE assemblies in lib/; every method
         body in them throws "Ref assembly". Head projects get the real implementations swapped in
         automatically, a test project does not - this is the lever that does it. -->
    <CodeBrixRuntimeIdentifier>skia</CodeBrixRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\libs\CodeBrixVideoTool.Processing\CodeBrixVideoTool.Processing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exporting a Mode 3 master to MP4 decodes it with the decoders the PROCESS registered, as the
         application does at start-up; the Processing library itself references no decoder. -->
    <PackageReference Include="CodeBrix.VideoPlayback.Dav1d.BsdLicenseForever" Version="1.0.271.1206" />
    <!-- The engine, for the same reason: the Processing library codes against the engine-neutral contract
         only, and the fixture registers the desktop's ffmpeg engine exactly as App does. The tests also
         use its FFProbe and FFMpegArguments directly to look at what was written. -->
    <PackageReference Include="CodeBrix.VideoProcessing.MitLicenseForever" Version="1.0.290.1023" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
