<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- This library hosts a SimpleViewModel-derived view model, so it references CodeBrix.Platform.
         Keep this library's OWN RootNamespace (not the app's "CodeBrixVideoTool") so the per-head
         generated GlobalStaticResources class does not collide across assemblies (CS0433). -->
    <RootNamespace>CodeBrixVideoTool.Playback</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The playback core: the chapter, caption and track types the player surface reports, and the
         container readers that answer "does this file have chapters or captions?" before it is opened. -->
    <PackageReference Include="CodeBrix.VideoPlayback.MitLicenseForever" Version="1.0.245.280" />

    <!-- AV1 video and Opus audio. These are the APPLICATION's dependencies, never the VideoPlayer
         add-in's: AV1 decoding is BSD-2-Clause and Opus is BSD-3-Clause while the add-in is
         Apache-2.0, so each ships as its own package and the application calls Register() once at
         start-up. Nothing plays without Dav1d; Opus is needed for WebM, MKV and Mode 1 (Mode 2
         carries Vorbis, which the core decodes itself). -->
    <PackageReference Include="CodeBrix.VideoPlayback.Dav1d.BsdLicenseForever" Version="1.0.245.303" />
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="1.0.245.260" />

    <!-- SimpleViewModel and SimpleCommand for the playback view model -->
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.243.226" />
  </ItemGroup>

  <ItemGroup>
    <!-- The playback view model asks the Processing library which formats exist and which of them
         the in-application player can open. -->
    <ProjectReference Include="..\CodeBrixVideoTool.Processing\CodeBrixVideoTool.Processing.csproj" />
  </ItemGroup>
</Project>
