<Project>
  <!-- Its own obj/bin folders: this project sits beside CodeBrixVideoTool.Processing.csproj, which builds the same sources -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj.android\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin.android\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <AssemblyName>CodeBrixVideoTool.Processing</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- This library hosts a SimpleViewModel-derived view model, so it references CodeBrix.Android.
         Keep this library's OWN RootNamespace (not the app's "CodeBrixVideoTool") so the per-head
         generated GlobalStaticResources class does not collide across assemblies (CS0433). -->
    <RootNamespace>CodeBrixVideoTool.Processing</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- The same packages as CodeBrixVideoTool.Processing.csproj: the authoring library, the playback
       core and the engine-neutral contract are the same assemblies on every platform. The engine is the
       application's choice, never this library's: the Android head registers the MediaCodec one. -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.VideoPlayback.Authoring.MitLicenseForever" Version="1.0.290.1224" />
    <PackageReference Include="CodeBrix.VideoPlayback.MitLicenseForever" Version="1.0.290.1224" />
    <PackageReference Include="CodeBrix.VideoProcessing.Core.MitLicenseForever" Version="1.0.290.1023" />
    <PackageReference Include="CodeBrix.Audio.Core.MitLicenseForever" Version="1.0.283.1382" />
    <PackageReference Include="CodeBrix.Audio.Vorbis.BsdLicenseForever" Version="1.0.283.1118" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twin of CodeBrix.Platform, for SimpleViewModel and SimpleCommand -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Android.ApacheLicenseForever" Version="1.0.292.307" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
