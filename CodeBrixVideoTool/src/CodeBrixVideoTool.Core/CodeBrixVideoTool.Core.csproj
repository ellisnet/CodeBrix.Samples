<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj.android/**;bin.android/**</DefaultItemExcludes>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>CodeBrixVideoTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <PackageReference Include="CodeBrix.Platform.Fonts.Roboto.OflLicenseForever" Version="1.0.248.1219" />
  </ItemGroup>

  <!-- The desktop heads: CodeBrix.Platform and its add-ins -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.291.1177" />

    <!-- The VideoPlayer add-in - the VideoPlayer element the main page hosts. Referenced ONCE here:
         every head inherits it transitively, and it is live on all four heads because the
         containers, the demultiplexer and the clock are all managed code. The two codec packages it
         plays through are the application's own and live in CodeBrixVideoTool.Playback. -->
    <PackageReference Include="CodeBrix.Platform.VideoPlayer.ApacheLicenseForever" Version="1.0.291.1177" />

    <!-- The desktop's video-processing ENGINE: it locates and runs the ffmpeg and ffprobe installed on
         the machine, and offers them to the libraries through the contract's external-tools facet. The
         libraries code against the engine-neutral contract only; the application picks the engine and
         App registers it once at start-up. CodeBrixVideoTool.Core.Android.csproj takes the Android
         engine here instead. -->
    <PackageReference Include="CodeBrix.VideoProcessing.MitLicenseForever" Version="1.0.290.1023" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\CodeBrixVideoTool.Processing\CodeBrixVideoTool.Processing.csproj" />
    <ProjectReference Include="..\libs\CodeBrixVideoTool.Playback\CodeBrixVideoTool.Playback.csproj" />
  </ItemGroup>
</Project>
