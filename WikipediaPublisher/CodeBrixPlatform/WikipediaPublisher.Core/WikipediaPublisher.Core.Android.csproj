<Project>
  <!-- Its own obj/bin folders: this project sits beside WikipediaPublisher.Core.csproj, which builds the same sources -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj.android\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin.android\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <AssemblyName>WikipediaPublisher.Core</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>WikipediaPublisher</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Shared\Helpers\FileDialogHelper.cs" Link="Helpers\FileDialogHelper.cs" />
    <Compile Include="..\..\Shared\Helpers\HostHelper.cs" Link="Helpers\HostHelper.cs" />
    <Compile Include="..\..\Shared\ViewModels\MainViewModel.cs" Link="ViewModels\MainViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />

    <!-- Bundled Open Sans font -->
    <PackageReference Include="CodeBrix.Platform.Fonts.OpenSans.ApacheLicenseForever" Version="1.0.248.1181" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twins of the same packages (the WebView twin
       shows pages in the device's system WebView) -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Android.ApacheLicenseForever" Version="1.0.292.307" />
    <PackageReference Include="CodeBrix.Android.WebView.ApacheLicenseForever" Version="1.0.292.307" />
    <PackageReference Include="CodeBrix.Android.FlexPanel.ApacheLicenseForever" Version="1.0.292.307" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helpers\" />
    <Folder Include="ViewModels\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WikipediaPublisher.RenderArticle\WikipediaPublisher.RenderArticle.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
