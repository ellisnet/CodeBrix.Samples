<Solution>
  <!-- KenneyAssetBrowser.WithAndroid.slnx
       The Android solution: everything in KenneyAssetBrowser.slnx PLUS the Android head and the
       .Android twins of its library projects, which need the .NET Android workload.
       Open KenneyAssetBrowser.slnx instead if you only have the plain .NET SDK. -->
  <Project Path="src/KenneyAssetBrowser.UI/KenneyAssetBrowser.UI.shproj" />
  <Project Path="src/KenneyAssetBrowser.Core/KenneyAssetBrowser.Core.csproj" />
  <Project Path="src/KenneyAssetBrowser.Core/KenneyAssetBrowser.Core.Android.csproj" />
  <Project Path="src/KenneyAssetBrowser.LinuxX11/KenneyAssetBrowser.LinuxX11.csproj" />
  <Project Path="src/KenneyAssetBrowser.LinuxWayland/KenneyAssetBrowser.LinuxWayland.csproj" />
  <Project Path="src/KenneyAssetBrowser.LinuxFrameBuffer/KenneyAssetBrowser.LinuxFrameBuffer.csproj" />
  <Project Path="src/KenneyAssetBrowser.MacOS/KenneyAssetBrowser.MacOS.csproj" />
  <Project Path="src/KenneyAssetBrowser.Win32Skia/KenneyAssetBrowser.Win32Skia.csproj" />
  <Project Path="src/KenneyAssetBrowser.WinWpfSkia/KenneyAssetBrowser.WinWpfSkia.csproj" />
  <Project Path="src/KenneyAssetBrowser.Android/KenneyAssetBrowser.Android.csproj" />
  <Folder Name="/Libraries/">
    <Project Path="src/libs/KenneyAssetBrowser.Settings/KenneyAssetBrowser.Settings.csproj" />
    <Project Path="src/libs/KenneyAssetBrowser.Settings/KenneyAssetBrowser.Settings.Android.csproj" />
    <Project Path="src/libs/KenneyAssetBrowser.AssetRead/KenneyAssetBrowser.AssetRead.csproj" />
    <Project Path="src/libs/KenneyAssetBrowser.Rendering/KenneyAssetBrowser.Rendering.csproj" />
    <Project Path="src/libs/KenneyAssetBrowser.Rendering/KenneyAssetBrowser.Rendering.Android.csproj" />
  </Folder>
  <Folder Name="/Tests/">
    <Project Path="tests/KenneyAssetBrowser.PlayTests/KenneyAssetBrowser.PlayTests.csproj" />
    <Project Path="tests/libs/KenneyAssetBrowser.Settings.Tests/KenneyAssetBrowser.Settings.Tests.csproj" />
    <Project Path="tests/libs/KenneyAssetBrowser.AssetRead.Tests/KenneyAssetBrowser.AssetRead.Tests.csproj" />
    <Project Path="tests/libs/KenneyAssetBrowser.Rendering.Tests/KenneyAssetBrowser.Rendering.Tests.csproj" />
  </Folder>
</Solution>
