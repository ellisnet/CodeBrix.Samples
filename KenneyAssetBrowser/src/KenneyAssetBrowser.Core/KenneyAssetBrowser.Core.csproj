<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>KenneyAssetBrowser</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.231.55" />
    <PackageReference Include="CodeBrix.Platform.Fonts.Merriweather.OflLicenseForever" Version="1.0.209.309" />
    <!-- FlexPanel - the wrapping header layout in the Browsing View -->
    <PackageReference Include="CodeBrix.Platform.FlexPanel.ApacheLicenseForever" Version="1.0.231.55" />
    <!-- SKXamlCanvas - the SkiaSharp drawing surface hosting the 2D image/spritesheet viewer -->
    <PackageReference Include="CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever" Version="4.151.0" />
    <!-- GLCanvasElement - the OpenGL surface behind the Rendering library's 3D model preview -->
    <PackageReference Include="CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever" Version="1.0.231.55" />
    <!-- AudioPlayer element - plays the packs' audio clips straight from their bytes; it
         decodes Ogg Vorbis (what Kenney ships), WAV, MP3 and FLAC itself -->
    <PackageReference Include="CodeBrix.Platform.AudioPlayer.ApacheLicenseForever" Version="1.0.231.55" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\KenneyAssetBrowser.Settings\KenneyAssetBrowser.Settings.csproj" />
    <ProjectReference Include="..\libs\KenneyAssetBrowser.AssetRead\KenneyAssetBrowser.AssetRead.csproj" />
    <ProjectReference Include="..\libs\KenneyAssetBrowser.Rendering\KenneyAssetBrowser.Rendering.csproj" />
  </ItemGroup>
</Project>
