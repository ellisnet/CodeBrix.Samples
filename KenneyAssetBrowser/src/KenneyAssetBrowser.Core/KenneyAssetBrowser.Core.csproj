<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android36.1</TargetFrameworks>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>KenneyAssetBrowser</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="CodeBrix.Platform.Fonts.Merriweather.OflLicenseForever" Version="1.0.248.1209" />
  </ItemGroup>

  <!-- The desktop heads: CodeBrix.Platform and its add-ins -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.281.314" />
    <!-- FlexPanel - the wrapping header layout in the Browsing View -->
    <PackageReference Include="CodeBrix.Platform.FlexPanel.ApacheLicenseForever" Version="1.0.281.314" />
    <!-- SKXamlCanvas - the SkiaSharp drawing surface hosting the 2D image/spritesheet viewer -->
    <PackageReference Include="CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever" Version="4.153.1" />
    <!-- GLCanvasElement - the OpenGL surface behind the Rendering library's 3D model preview -->
    <PackageReference Include="CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever" Version="1.0.281.314" />
    <!-- AudioPlayer element - plays the packs' audio clips straight from their bytes; it
         decodes Ogg Vorbis (what Kenney ships), WAV, MP3 and FLAC itself -->
    <PackageReference Include="CodeBrix.Platform.AudioPlayer.ApacheLicenseForever" Version="1.0.281.314" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twins of the same packages (the AudioPlayer
       twin plays through CodeBrix.Audio.Android, which it initialises itself) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.1'">
    <PackageReference Include="CodeBrix.Android.ApacheLicenseForever" Version="1.0.281.1188" />
    <PackageReference Include="CodeBrix.Android.FlexPanel.ApacheLicenseForever" Version="1.0.281.1188" />
    <PackageReference Include="CodeBrix.Android.SkiaSharp.Views.ApacheLicenseForever" Version="1.0.281.1188" />
    <PackageReference Include="CodeBrix.Android.Graphics3DGL.ApacheLicenseForever" Version="1.0.281.1188" />
    <PackageReference Include="CodeBrix.Android.AudioPlayer.ApacheLicenseForever" Version="1.0.281.1188" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\KenneyAssetBrowser.Settings\KenneyAssetBrowser.Settings.csproj" />
    <ProjectReference Include="..\libs\KenneyAssetBrowser.AssetRead\KenneyAssetBrowser.AssetRead.csproj" />
    <ProjectReference Include="..\libs\KenneyAssetBrowser.Rendering\KenneyAssetBrowser.Rendering.csproj" />
  </ItemGroup>
</Project>
