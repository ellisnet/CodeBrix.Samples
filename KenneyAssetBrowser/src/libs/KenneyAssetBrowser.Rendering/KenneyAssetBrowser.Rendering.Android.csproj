<Project>
  <!-- Its own obj/bin folders: this project sits beside KenneyAssetBrowser.Rendering.csproj, which builds the same sources -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj.android\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin.android\</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <AssemblyName>KenneyAssetBrowser.Rendering</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- This library now hosts the 3D preview control itself (ModelSceneGlCanvas, a
         Graphics3DGL GLCanvasElement subclass), so it references CodeBrix.Platform and its
         WinUI-compat XAML surface. Keep this library's OWN RootNamespace (not the app's
         "KenneyAssetBrowser") so the per-head generated GlobalStaticResources class does not
         collide across assemblies (CS0433). -->
    <RootNamespace>KenneyAssetBrowser.Rendering</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" Version="1.0.285.619" />

    <!-- glTF 2.0 loading, plus scene evaluation (EvaluateTriangles) that CPU-bakes animation clips for the preview -->
    <PackageReference Include="CodeBrix.Graphics3D.Gltf2.MitLicenseForever" Version="1.0.261.293" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />

    <!-- Rasterizes the packs' SVG vector art for the 2D viewer (brings its own SkiaSharp dependency; the direct reference above lifts it to 4.153.1) -->
    <PackageReference Include="CodeBrix.SkiaSvg.MitLicenseForever" Version="1.0.284.1048" />
  </ItemGroup>

  <!-- The Android head: the CodeBrix.Android twins of the same two packages (GLCanvasElement
       renders on an OpenGL ES 3.0 context there, which GlModelSceneRenderer already handles) -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Android.ApacheLicenseForever" Version="1.0.292.307" />
    <PackageReference Include="CodeBrix.Android.Graphics3DGL.ApacheLicenseForever" Version="1.0.292.307" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
